{
  "name": "alt-ai",
  "version": "0.2.0",
  "private": true,
  "description": "ALT-AI — assistente pessoal local",
  "author": "ALT-AI",
  "main": "apps/desktop/electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.ts",
    "start": "node scripts/start.mjs",
    "test": ".venv\\Scripts\\python.exe -m pytest tests -q && node --test tests/update-security.test.cjs",
    "backend:build": ".venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean backend.spec",
    "dist": "npm run build && npm run backend:build && node scripts/build-windows.cjs",
    "pack": "npm run build && npm run backend:build && node scripts/build-windows.cjs --dir",
    "release:manifest": "node scripts/sign-update.mjs",
    "dist:signed": "node scripts/check-signing.mjs && npm run build && npm run backend:build && node scripts/build-windows.cjs --signed"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "com.altai.desktop",
    "productName": "ALT-AI",
    "asar": true,
    "electronFuses": {"runAsNode":false,"enableNodeOptionsEnvironmentVariable":false,"enableNodeCliInspectArguments":false,"enableEmbeddedAsarIntegrityValidation":true,"onlyLoadAppFromAsar":true},
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "apps/desktop/electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/alt-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "ALT-AI-Setup-${version}-${arch}.${ext}"
    }
  }
}
